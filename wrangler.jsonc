{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pm",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "7161f73e7a5a97a5d2fe7ad26e7e28f9",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pm.maximefilippini.me", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pm-registry",
      "database_id": "1bc07a26-eadb-4bde-92fb-62bb45661896",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD are passed only at deploy time (see the "deploy"
  // script), so local dev never sees them and DEV_ACCESS_EMAIL cannot trip the fail-closed check.
  "vars": {
    "ADMIN_EMAILS": "maxime.filippini@gmail.com"
  }
}
